指令：扩展为复利 vs 单利对比表：年限 10/20/30 年三行，列输出"复利终值/单利终值/差额"

# -*- coding: utf-8 -*-
# 交互式复利 vs 单利对比程序
#
# 复利公式（每年复利 1 次）：A = P * (1 + r) ** t   —— 利滚利，利息也生息
# 单利公式：                A = P * (1 + r * t)     —— 只有本金生息
#   A —— 最终本息和
#   P —— 本金
#   r —— 年利率（小数）
#   t —— 存款年数

# ---------- 输入本金 ----------
# input() 读到的是字符串，float() 把它转成小数
P = float(input("请输入本金（元）："))

# ---------- 输入年利率 ----------
# while True 循环：利率为负就提示并重输，合法才 break 跳出
while True:
    rate_percent = float(input("请输入年利率（%，如 5 表示 5%）："))  # 用户输入百分数
    if rate_percent < 0:                 # 利率为负
        print("利率不能为负")            # 提示错误
        continue                         # 回到循环开头重新输入
    break                                # 输入合法，跳出循环
r = rate_percent / 100  # 百分数换小数，5 -> 0.05

# ---------- 要对比的年限 ----------
years_list = [10, 20, 30]  # 表格三行分别对应 10 年、20 年、30 年

# ---------- 输出对比表 ----------
# 表头：<8 表示左对齐占 8 个字符宽度，>16 表示右对齐占 16 个字符宽度
print("")
print("复利 vs 单利对比表（本金 {:,.2f} 元，年利率 {:.2f}%）".format(P, rate_percent))
print("-" * 54)
print("{:<8}{:>16}{:>16}{:>14}".format("年限", "复利终值", "单利终值", "差额"))
print("-" * 54)

# 逐个年限计算并打印一行
for t in years_list:
    compound = P * (1 + r) ** t   # 复利终值：(1+r) 的 t 次方，利息也参与计息
    simple = P * (1 + r * t)      # 单利终值：利息 = 本金 * 利率 * 年数，不再生息
    diff = compound - simple      # 差额：复利比单利多拿到的钱

    # , 表示千位分隔符，.2f 表示保留两位小数
    print("{:<8}{:>16,.2f}{:>16,.2f}{:>14,.2f}".format(
        "{}年".format(t), compound, simple, diff))

print("-" * 54)





